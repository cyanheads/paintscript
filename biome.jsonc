{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "scripts/**", "tests/**", "examples/**", "*.json", "*.ts", "!dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error"
      },
      "style": {
        // Off: the engine is typed-array kernels under noUncheckedIndexedAccess, where
        // every index is in bounds by construction; `a[i]!` states that bound, and a
        // `?? 0` per read would hide a real out-of-bounds bug and slow the hot loops.
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useThrowOnlyError": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noVar": "error",
        "useAwait": "warn",
        "noImportCycles": "error",
        "noUnusedExpressions": "error",
        "noDeprecatedImports": "error"
      },
      "complexity": {
        "noUselessUndefined": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedInterfaceMembers": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "useAwait": "off"
          },
          "style": {
            "useThrowOnlyError": "off"
          }
        }
      }
    },
    {
      "includes": ["package.json"],
      "json": {
        "formatter": {
          "expand": "auto"
        }
      }
    }
  ]
}
