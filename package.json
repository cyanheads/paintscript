{
  "name": "paintscript",
  "version": "0.1.0",
  "description": "Paint by code: sandboxed JavaScript lays bristle strokes of Kubelka–Munk oil paint, rendered to PNG and timelapse GIF.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/paintscript.git"
  },
  "homepage": "https://github.com/cyanheads/paintscript#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/paintscript/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "keywords": [
    "painting",
    "oil-painting",
    "paint-simulation",
    "brush-simulation",
    "kubelka-munk",
    "spectral-rendering",
    "generative-art",
    "creative-coding",
    "quickjs",
    "sandbox",
    "webassembly",
    "timelapse",
    "gif",
    "llm",
    "ai-agents",
    "typescript",
    "bun",
    "cyanheads"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.5",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "paintscript": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "changelog/",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "rebuild": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "changelog:build": "bun run scripts/build-changelog.ts",
    "changelog:check": "bun run scripts/build-changelog.ts --check",
    "check": "bun run typecheck && bun run lint && vitest run --passWithNoTests && bun run changelog:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "quickjs-emscripten-core": "^0.32.0",
    "zod": "^4.6.7"
  }
}
